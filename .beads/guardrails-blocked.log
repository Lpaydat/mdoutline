import sys

# Read the original mdoutline.py
with open('/home/lpaydat/workspace/mdoutline/mdoutline.py', 'r') as f:
    content = f.read()

# Find the position to insert the new function (before render_outline)
insert_marker = 'def render_outline(headings: list[tuple[int, str]]) -> str:'

if insert_marker not in content:
    print("ERROR: Could not find insertion point", file=sys.stderr)
    sys.exit(1)

new_function = '''def number_headings(headings: list[tuple[int, str]]) -> list[tuple[int, str, str]]:
    """Number headings according to hierarchical outline numbering.

    A heading at depth d increments counter[d] and resets ALL deeper counters to 0.
    The number for a heading at depth d joins counter[1..d] with dots.
    Format: depth 1 gets a trailing dot ("1.", "2."); depth >= 2 gets none ("1.1", "1.2.1").
    Skipped intermediate level renders a mechanical 0: h1 followed directly by h3 -> "1.0.1".

    Args:
        headings: A list of (depth, text) tuples from extract_headings().

    Returns:
        A new list of (depth, text, number) tuples where number is the computed
        hierarchical heading number. Does not mutate the input list.

    Examples:
        >>> headings = [(1, "A"), (2, "B"), (2, "C"), (3, "D"), (2, "E"), (1, "F")]
        >>> number_headings(headings)
        [(1, 'A', '1.'), (2, 'B', '1.1'), (2, 'C', '1.2'), (3, 'D', '1.2.1'), (2, 'E', '1.3'), (1, 'F', '2.')]
    """
    if not headings:
        return []

    result: list[tuple[int, str, str]] = []
    counter: dict[int, int] = {}

    for depth, text in headings:
        # Increment the counter for this depth
        counter[depth] = counter.get(depth, 0) + 1

        # Reset all deeper counters to 0
        for d in list(counter.keys()):
            if d > depth:
                counter[d] = 0

        # Build the number by joining counters[1..depth] with dots
        parts = [str(counter.get(d, 0)) for d in range(1, depth + 1)]
        number = ".".join(parts)

        # Add trailing dot for depth 1 only
        if depth == 1:
            number += "."

        result.append((depth, text, number))

    return result


'''

# Insert the new function
new_content = content.replace(insert_marker, new_function + insert_marker)

# Write back
with open('/home/lpaydat/workspace/mdoutline/mdoutline.py', 'w') as f:
    f.write(new_content)

print("Successfully added number_headings function to mdoutline.py")
