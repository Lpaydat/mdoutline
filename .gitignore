# Python gitignore patterns
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.tmp_*
traces/

# Global gitignore — applies to all projects
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Agent workspace directories (shared checkout)
.traces/
.driver/
.pi/
